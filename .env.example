# Servidor
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000

# Banco (Railway injeta DATABASE_URL automaticamente)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/soschat
# Forçar SSL na conexão (Railway via proxy público precisa; interno não)
PGSSL=false

# Auth
JWT_SECRET=troque-por-uma-string-longa-e-aleatoria
JWT_EXPIRES_IN=12h

# Primeiro admin (usado pelo npm run seed)
SEED_ADMIN_NAME=Administrador
SEED_ADMIN_EMAIL=admin@sosbuscas.com.br
SEED_ADMIN_PASSWORD=trocar123

# Provedor do WhatsApp: baileys (QR code, não oficial) ou cloud (API oficial da Meta)
WA_PROVIDER=baileys

# WhatsApp Business Cloud API (Meta) — só usado com WA_PROVIDER=cloud
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=
WA_APP_SECRET=
WA_VERIFY_TOKEN=sos-verify-token
WA_API_VERSION=v21.0

# Em desenvolvimento, habilita POST /api/dev/simulate-inbound para testar sem WhatsApp
ENABLE_DEV_SIMULATOR=true

# Pré-consulta de placa/chassi (fontes; sem elas usa o site Ke Placa via Chromium, que costuma ser barrado em servidores)
WEBXCAR_API_KEY=
APIPLACAS_TOKEN=
